# ============================================================================
# REQUIRED: Supabase Authentication Configuration
# ============================================================================

# VITE_SUPABASE_URL (REQUIRED)
# The URL of your Supabase project
# Format: https://your-project-id.supabase.co
# Where to find: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# VITE_SUPABASE_PUBLISHABLE_KEY (REQUIRED)
# The publishable (anon) key for your Supabase project
# This key is safe to use in browser code
# Format: Long alphanumeric string starting with 'eyJ...'
# Where to find: Supabase Dashboard > Project Settings > API > Project API keys > anon/public
# WARNING: Never use the service_role key in frontend code!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ============================================================================
# OPTIONAL: Site URL Configuration
# ============================================================================

# VITE_SITE_URL (OPTIONAL but RECOMMENDED for production)
# The canonical URL where your application is deployed
# Used for email verification redirects and password reset links
# 
# Development:
#   - Can be omitted (defaults to window.location.origin, typically http://localhost:5173)
#   - If set, use: http://localhost:5173
# 
# Production:
#   - Should be set to your production domain (e.g., https://yourdomain.com)
#   - Must match the redirect URLs configured in Supabase Dashboard
#   - Format: Full URL with protocol, no trailing slash
# 
# Supabase Setup:
#   - Go to: Supabase Dashboard > Authentication > URL Configuration
#   - Add to "Redirect URLs": <VITE_SITE_URL>/ (with trailing slash)
#   - Example: https://yourdomain.com/
VITE_SITE_URL=https://news.example.com

# ============================================================================
# OPTIONAL: Google OAuth Integration
# ============================================================================

# VITE_GOOGLE_OAUTH_CLIENT_ID (OPTIONAL - Required for Google Drive & YouTube integration)
# Google Cloud OAuth 2.0 Client ID for web application
# Format: xxx.apps.googleusercontent.com
# Where to find: Google Cloud Console > APIs & Services > Credentials
# Create: OAuth 2.0 Client ID > Web application
# 
# Authorized redirect URIs (add these in Google Cloud Console):
#   - Development: https://your-project.supabase.co/functions/v1/google-drive-oauth-callback
#   - Development: https://your-project.supabase.co/functions/v1/youtube-oauth-callback
#   - Production: https://your-project.supabase.co/functions/v1/google-drive-oauth-callback
#   - Production: https://your-project.supabase.co/functions/v1/youtube-oauth-callback
# 
# Required API scopes:
#   - Google Drive: https://www.googleapis.com/auth/drive.file
#   - YouTube: https://www.googleapis.com/auth/youtube.readonly
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ============================================================================
# OPTIONAL: Application Configuration
# ============================================================================

# VITE_SITE_MODE (OPTIONAL)
# Set to "saas" on sangtx.com to show the SangTX marketing homepage at /.
# Leave unset (or set to "news") on tenant news portal deployments.
VITE_SITE_MODE=saas

# ============================================================================
# OPTIONAL: Firebase Cloud Messaging Configuration
# ============================================================================

# Optional Firebase Cloud Messaging public configuration.
# Only required if you want to enable push notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Supabase Edge Functions)
# ============================================================================
# The following variables are NOT prefixed with VITE_ and should be configured
# in Supabase Dashboard > Project Settings > Edge Functions > Secrets
#
# Required for Google Drive Integration:
#   - GOOGLE_OAUTH_CLIENT_ID (same as VITE_GOOGLE_OAUTH_CLIENT_ID)
#   - GOOGLE_OAUTH_CLIENT_SECRET (from Google Cloud Console - NEVER commit to git!)
#   - GDRIVE_ENCRYPTION_KEY (generate: openssl rand -base64 32)
#   - SUPABASE_URL (auto-provided by Supabase)
#   - SUPABASE_SERVICE_ROLE_KEY (auto-provided by Supabase)
#   - SITE_URL (your frontend URL, e.g., https://news.example.com)
#
# Required for YouTube Integration:
#   - GOOGLE_OAUTH_CLIENT_ID (same as above, shared with Drive)
#   - GOOGLE_OAUTH_CLIENT_SECRET (same as above, shared with Drive)
#   - YOUTUBE_ENCRYPTION_KEY (generate: openssl rand -base64 32)
#   - SUPABASE_URL (auto-provided by Supabase)
#   - SUPABASE_SERVICE_ROLE_KEY (auto-provided by Supabase)
#   - SITE_URL (your frontend URL, e.g., https://news.example.com)
#
# To set these in Supabase:
#   supabase secrets set GOOGLE_OAUTH_CLIENT_SECRET=your_secret_here
#   supabase secrets set GDRIVE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   supabase secrets set YOUTUBE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#
# SECURITY WARNING:
#   - NEVER commit GOOGLE_OAUTH_CLIENT_SECRET to version control
#   - NEVER expose encryption keys in frontend code
#   - Use different encryption keys for Drive and YouTube
# ============================================================================
