# ============================================================================
# REQUIRED: Supabase Authentication Configuration
# ============================================================================

# VITE_SUPABASE_URL (REQUIRED)
# The URL of your Supabase project
# Format: https://your-project-id.supabase.co
# Where to find: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# VITE_SUPABASE_PUBLISHABLE_KEY (REQUIRED)
# The publishable (anon) key for your Supabase project
# This key is safe to use in browser code
# Format: Long alphanumeric string starting with 'eyJ...'
# Where to find: Supabase Dashboard > Project Settings > API > Project API keys > anon/public
# WARNING: Never use the service_role key in frontend code!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ============================================================================
# OPTIONAL: Site URL Configuration
# ============================================================================

# VITE_SITE_URL (OPTIONAL but RECOMMENDED for production)
# The canonical URL where your application is deployed
# Used for email verification redirects and password reset links
# 
# Development:
#   - Can be omitted (defaults to window.location.origin, typically http://localhost:5173)
#   - If set, use: http://localhost:5173
# 
# Production:
#   - Should be set to your production domain (e.g., https://yourdomain.com)
#   - Must match the redirect URLs configured in Supabase Dashboard
#   - Format: Full URL with protocol, no trailing slash
# 
# Supabase Setup:
#   - Go to: Supabase Dashboard > Authentication > URL Configuration
#   - Add to "Redirect URLs": <VITE_SITE_URL>/ (with trailing slash)
#   - Example: https://yourdomain.com/
VITE_SITE_URL=https://news.example.com

# ============================================================================
# OPTIONAL: Google OAuth Integration
# ============================================================================

# VITE_GOOGLE_OAUTH_CLIENT_ID (OPTIONAL - Required for Google integrations)
# Google Cloud OAuth 2.0 Client ID for web application
# Format: xxx.apps.googleusercontent.com
# Where to find: Google Cloud Console > APIs & Services > Credentials
# Create: OAuth 2.0 Client ID > Web application
# 
# Authorized redirect URIs (add ALL of these in Google Cloud Console):
#   Development (localhost):
#     - https://your-project.supabase.co/functions/v1/ga4-oauth-callback
#     - https://your-project.supabase.co/functions/v1/gsc-oauth-callback
#     - https://your-project.supabase.co/functions/v1/google-drive-oauth-callback
#     - https://your-project.supabase.co/functions/v1/youtube-oauth-callback
#   
#   Production:
#     - https://your-project.supabase.co/functions/v1/ga4-oauth-callback
#     - https://your-project.supabase.co/functions/v1/gsc-oauth-callback
#     - https://your-project.supabase.co/functions/v1/google-drive-oauth-callback
#     - https://your-project.supabase.co/functions/v1/youtube-oauth-callback
# 
# Required API scopes (enable these APIs in Google Cloud Console):
#   - Google Analytics Admin API v1beta (for GA4 integration)
#   - Google Analytics Data API v1beta (for GA4 reporting)
#   - Google Search Console API v1 (for GSC integration)
#   - Google Drive API v3 (for media storage)
#   - YouTube Data API v3 (for YouTube widget)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ============================================================================
# OPTIONAL: Facebook OAuth Integration
# ============================================================================

# VITE_FACEBOOK_APP_ID (OPTIONAL - Required for Facebook Publisher integration)
# Facebook App ID from Meta for Developers
# Format: Numeric string (e.g., 1234567890123456)
# Where to find: Meta for Developers > Your Apps > Settings > Basic > App ID
# 
# Setup:
#   1. Create Facebook App at https://developers.facebook.com/apps
#   2. Add Facebook Login product
#   3. Configure OAuth redirect URIs:
#      - https://your-project.supabase.co/functions/v1/facebook-oauth-callback
#   4. Request permissions: pages_manage_posts, pages_read_engagement, pages_show_list
VITE_FACEBOOK_APP_ID=

# ============================================================================
# OPTIONAL: Application Configuration
# ============================================================================

# VITE_SITE_MODE (OPTIONAL)
# Set to "saas" on sangtx.com to show the SangTX marketing homepage at /.
# Leave unset (or set to "news") on tenant news portal deployments.
VITE_SITE_MODE=saas

# ============================================================================
# OPTIONAL: Firebase Cloud Messaging Configuration
# ============================================================================

# Optional Firebase Cloud Messaging public configuration.
# Only required if you want to enable push notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Supabase Edge Functions)
# ============================================================================
# The following variables are NOT prefixed with VITE_ and should be configured
# in Supabase Dashboard > Project Settings > Edge Functions > Secrets
#
# ── Google OAuth (Shared across all Google integrations) ────────────────────
#   GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
#   GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx (from Google Cloud Console)
#   
# ── Google Analytics (GA4) ──────────────────────────────────────────────────
#   GA4_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   FRONTEND_URL=http://localhost:5173 (or https://your-domain.com)
#   
# ── Google Search Console ───────────────────────────────────────────────────
#   GSC_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   
# ── Google Drive Storage ────────────────────────────────────────────────────
#   GDRIVE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   
# ── YouTube Integration ─────────────────────────────────────────────────────
#   YOUTUBE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   
# ── Facebook Publisher ──────────────────────────────────────────────────────
#   FACEBOOK_APP_ID=1234567890123456
#   FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   FACEBOOK_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   FRONTEND_URL=http://localhost:5173 (or https://your-domain.com)
#   
# ── Auto-provided by Supabase ───────────────────────────────────────────────
#   SUPABASE_URL (auto-provided)
#   SUPABASE_SERVICE_ROLE_KEY (auto-provided)
#
# To set these in Supabase Edge Functions:
#   supabase secrets set GOOGLE_OAUTH_CLIENT_SECRET=your_secret_here
#   supabase secrets set GA4_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   supabase secrets set GSC_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   supabase secrets set GDRIVE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   supabase secrets set YOUTUBE_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   supabase secrets set FACEBOOK_APP_SECRET=your_secret_here
#   supabase secrets set FACEBOOK_ENCRYPTION_KEY=$(openssl rand -base64 32)
#   supabase secrets set FRONTEND_URL=http://localhost:5173
#
# SECURITY WARNING:
#   - NEVER commit OAuth secrets to version control
#   - NEVER expose encryption keys in frontend code
#   - Use different encryption keys for each service
#   - Rotate encryption keys periodically in production
# ============================================================================
